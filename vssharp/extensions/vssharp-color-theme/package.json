{
  "name": "vssharp-color-theme",
  "displayName": "VS Sharp Color Theme",
  "description": "JetBrains New UI inspired color theme for VS Sharp.",
  "publisher": "vssharp",
  "version": "1.0.0",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Themes"],
  "extensionKind": ["ui", "workspace"],
  "contributes": {
    "themes": [
      {
        "label": "| Dark | JetBrains New UI Color Theme",
        "id": "dark-jetbrains-color-theme",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-jetbrains-color-theme.json"
      },
      {
        "label": "| Light | JetBrains New UI Color Theme",
        "id": "light-jetbrains-color-theme",
        "uiTheme": "vs",
        "path": "./themes/light-jetbrains-color-theme.json"
      }
    ]
  }
}
