{
  "name": "vssharp-icons",
  "displayName": "VS Sharp Icons",
  "description": "Shared JetBrains icon set for VS Sharp extensions.",
  "publisher": "vssharp",
  "version": "1.0.0",
  "engines": { "vscode": "^1.73.0" },
  "categories": ["Other"],
  "main": "./extension/main.js",
  "scripts": {
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.73.0",
    "copy-webpack-plugin": "^12.0.2",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "iconThemes": [
      {
        "id": "vssharp-file-icon",
        "label": "VS Sharp File Icons",
        "path": "./media/vssharp-file-icons.json"
      }
    ]
  }
}
