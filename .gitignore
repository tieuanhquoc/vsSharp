# Upstream VSCodium ignores
vscode*
VSCode-*/
VSCodium-*/
VSCodium/

# VS Sharp source overrides (not the build artifact)
!vssharp/vscode-overrides/
!vssharp/vscode-overrides/**
.DS_Store
*.env
assets/
# Exception: docs assets (README images, etc.) must ship in the repo
!docs/assets/
!docs/assets/**
build/linux/appimage/out
build/linux/appimage/pkg2appimage.AppDir
build/linux/appimage/pkg2appimage-*.AppImage
build/linux/appimage/pkg2appimage.AppImage
build/linux/appimage/squashfs-root
build/linux/appimage/VSCodium
build/windows/msi/releasedir
build/windows/msi/Files*.wxs
build/windows/msi/Files*.wixobj
sourcemaps/
stores/snapcraft/insider/*.snap
stores/snapcraft/stable/*.snap
font-size/node_modules/
font-size/generate-css.js

# VS Sharp dev environment
.venv/
.claude/settings.local.json

# Node / npm
node_modules/
*.log
npm-debug.log*

# vssharp generic build artifacts
vssharp/extensions/*/node_modules/
vssharp/extensions/*/out/

# Third-party extensions fetched by vssharp/install-*.sh (not committed).
# Pin commit + local patches live in vssharp/<name>.UPSTREAM.txt + vssharp/<name>.patches/.
vssharp/extensions/dotrush/

# vssharp-runner — built bundle excluded (rebuild via npm run compile)
vssharp/extensions/vssharp-runner/extension/

# IDE
.idea/
.vscode/
*.swp
.zed/
