{
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "filePattern": "*.ts",
          "hooks": [
            {
              "type": "command",
              "command": "npx tsc --noEmit 2>&1 | head -30"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Edit|Write",
          "filePattern": "*.local.sh|config.yml",
          "hooks": [
            {
              "type": "command",
              "command": "echo BLOCKED: sensitive file; exit 1"
            }
          ]
        }
      ]
    }
  }